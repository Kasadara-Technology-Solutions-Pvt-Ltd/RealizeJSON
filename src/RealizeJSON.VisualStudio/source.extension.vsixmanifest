<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Id="RealizeJSON.VisualStudio.6f3d9a7e-2c4b-4e8a-9b1d-5a7c3e2f8d10" Version="1.0.1" Language="en-US" Publisher="Kasadara" />
    <DisplayName>RealizeJSON - Live JSON Serialization Preview</DisplayName>
    <Description>Visualize how your C# types serialize into JSON in real time, without building or running your application. Static preview with System.Text.Json and Newtonsoft.Json rules; sample values are illustrative, not guaranteed runtime output.</Description>
    <MoreInfo>https://github.com/Kasadara-Technology-Solutions-Pvt-Ltd/RealizeJSON</MoreInfo>
    <License>LICENSE</License>
    <ReleaseNotes>https://github.com/Kasadara-Technology-Solutions-Pvt-Ltd/RealizeJSON/blob/main/CHANGELOG.md</ReleaseNotes>
    <Icon>Resources\RealizeJSON-128.png</Icon>
    <PreviewImage>Resources\RealizeJSON-preview-200.png</PreviewImage>
    <Tags>json;serialization;System.Text.Json;Newtonsoft.Json;Roslyn;DTO;API;preview;contract</Tags>
  </Metadata>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[18.0,)">
      <ProductArchitecture>amd64</ProductArchitecture>
    </InstallationTarget>
  </Installation>
  <Dependencies>
    <Dependency Id="Microsoft.Framework.NDP" DisplayName="Microsoft .NET Framework" d:Source="Manual" Version="[4.7.2,)" />
  </Dependencies>
  <Prerequisites>
    <Prerequisite Id="Microsoft.VisualStudio.Component.CoreEditor" Version="[17.0,)" DisplayName="Visual Studio core editor" />
    <Prerequisite Id="Microsoft.VisualStudio.Component.Roslyn.LanguageServices" Version="[17.0,)" DisplayName="C# and Visual Basic" />
  </Prerequisites>
  <Assets>
    <Asset Type="Microsoft.VisualStudio.VsPackage" d:Source="Project" d:ProjectName="%CurrentProject%" Path="|%CurrentProject%;PkgdefProjectOutputGroup|" />
    <Asset Type="Microsoft.VisualStudio.MefComponent" d:Source="Project" d:ProjectName="%CurrentProject%" Path="|%CurrentProject%|" />
  </Assets>
</PackageManifest>
